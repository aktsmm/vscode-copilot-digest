{
  "name": "vscode-copilot-digest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "collect": "node scripts/collect.mjs && node scripts/enrich-resources.mjs",
    "enrich:resources": "node scripts/enrich-resources.mjs",
    "audit:resources": "node scripts/enrich-resources.mjs --audit",
    "render:summaries": "node scripts/collect.mjs --render-existing",
    "render:drafts": "node scripts/render-drafts.mjs",
    "biweekly": "node scripts/build-biweekly.mjs",
    "weekly": "node scripts/build-weekly.mjs",
    "notify:discord": "node scripts/notify-discord.mjs",
    "build:pages": "node scripts/build-pages.mjs && pagefind --site site --output-subdir pagefind && node scripts/finalize-search.mjs",
    "build:pdfs": "node scripts/build-slide-pdfs.mjs",
    "test:data": "node tests/reporting-low-information.test.mjs && node tests/sources.test.mjs && node tests/resources.test.mjs && node tests/api-slides.test.mjs",
    "test:pages": "node tests/pages-discord-ux.test.mjs && node tests/resource-pages.test.mjs",
    "test": "npm run test:data && npm run test:pages"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "diff": "^9.0.0",
    "fast-xml-parser": "^5.8.0",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "pagefind": "^1.3.0",
    "playwright": "^1.65.0-alpha-2026-10-07"
  }
}
