{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vscode-copilot-digest slide",
  "type": "object",
  "required": ["schema", "id", "title", "date", "topic", "status", "summary", "points", "references", "evidence"],
  "properties": {
    "schema": { "const": "vscode-copilot-digest/slide/v1" },
    "id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "title": { "type": "object", "required": ["ja"], "properties": { "ja": { "type": "string", "maxLength": 80 }, "en": { "type": "string" } } },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "topic": { "enum": ["GitHub Copilot", "VS Code", "GitHub Platform", "周辺ニュース"] },
    "status": { "enum": ["ga", "preview", "retirement", "announcement", "update", "unknown"] },
    "statusEvidence": { "type": "string" },
    "summary": { "type": "string", "maxLength": 220 },
    "points": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string", "maxLength": 120 } },
    "references": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": { "type": "string", "pattern": "^https://" },
        "documents": { "type": "array", "maxItems": 3, "items": { "type": "object", "required": ["title", "url"], "properties": { "title": { "type": "string" }, "url": { "type": "string", "pattern": "^https://" } } } }
      }
    },
    "audience": { "type": "object", "required": ["who", "change"], "properties": { "who": { "type": "string", "maxLength": 100 }, "change": { "type": "string", "maxLength": 100 } } },
    "action": { "type": "string", "maxLength": 120 },
    "beforeAfter": { "type": "object", "required": ["before", "after"], "properties": { "before": { "type": "string", "maxLength": 100 }, "after": { "type": "string", "maxLength": 100 } } },
    "timeline": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "object", "required": ["when", "label"], "properties": { "when": { "type": "string", "maxLength": 20 }, "label": { "type": "string", "maxLength": 40 } } } },
    "glossary": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "object", "required": ["term", "oneLine"], "properties": { "term": { "type": "string", "maxLength": 40 }, "oneLine": { "type": "string", "maxLength": 100 } } } },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^https://" } }
  }
}
