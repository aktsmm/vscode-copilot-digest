{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vscode-copilot-digest slide v2 (1 update = 1 slide)",
  "type": "object",
  "required": ["schema", "id", "title", "date", "topic", "status", "audience", "action", "panels", "references", "evidence"],
  "properties": {
    "schema": { "const": "vscode-copilot-digest/slide/v2" },
    "id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "title": {
      "type": "object",
      "required": ["ja", "original"],
      "properties": {
        "ja": { "type": "string", "maxLength": 80 },
        "subtitleJa": { "type": "string", "maxLength": 70 },
        "original": { "type": "string", "maxLength": 160 }
      }
    },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "topic": { "enum": ["GitHub Copilot", "VS Code", "GitHub Platform", "周辺ニュース"] },
    "status": { "enum": ["ga", "preview", "retirement", "announcement", "update", "unknown"] },
    "statusEvidence": { "type": "string" },
    "audience": {
      "type": "object",
      "required": ["who", "change", "changeNature"],
      "properties": {
        "who": { "type": "string", "maxLength": 90 },
        "change": { "type": "string", "maxLength": 110 },
        "changeNature": { "enum": ["benefit", "neutral", "breaking"] }
      }
    },
    "action": {
      "type": "object",
      "required": ["required", "summary"],
      "properties": {
        "required": { "enum": ["yes", "optional", "no", "info"] },
        "summary": { "type": "string", "maxLength": 110 },
        "deadline": { "type": "string", "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$" }
      }
    },
    "beforeAfter": {
      "type": "object",
      "required": ["before", "after"],
      "properties": { "before": { "type": "string", "maxLength": 100 }, "after": { "type": "string", "maxLength": 100 } }
    },
    "timeline": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": { "type": "object", "required": ["when", "label"], "properties": { "when": { "type": "string", "maxLength": 20 }, "label": { "type": "string", "maxLength": 40 } } }
    },
    "panels": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "heading", "priority", "items"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$" },
          "heading": { "type": "string", "maxLength": 20 },
          "priority": { "enum": ["core", "detail"] },
          "items": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string", "maxLength": 100 } }
        }
      }
    },
    "glossary": {
      "type": "array", "minItems": 1, "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["term", "type", "oneLine"],
        "properties": { "term": { "type": "string", "maxLength": 40 }, "type": { "enum": ["product", "feature", "term", "label"] }, "oneLine": { "type": "string", "maxLength": 90 } }
      }
    },
    "suggestions": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "maxLength": 100 } },
    "references": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": {
          "type": "object",
          "required": ["title", "url"],
          "properties": { "title": { "type": "string", "minLength": 8, "maxLength": 120 }, "url": { "type": "string", "pattern": "^https://" } }
        },
        "documents": {
          "type": "array", "maxItems": 3,
          "items": { "type": "object", "required": ["title", "url"], "properties": { "title": { "type": "string" }, "url": { "type": "string", "pattern": "^https://" } } }
        }
      }
    },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^https://" } }
  }
}
